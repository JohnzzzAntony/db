# NVIDIA API key for the study generator (keep it secret; set it in Vercel's Environment Variables).
NVIDIA_API_KEY=""
# NVIDIA_MODEL="z-ai/glm-5.3-flash"

# Strongly recommended on a public site: a code students enter once (Settings) before they can generate.
# Without it, anyone who finds the site can use up your NVIDIA quota.
ACCESS_CODE=""

# Optional
# AI_HOURLY_LIMIT=20            # generations per device per hour (best effort)
# ANTHROPIC_API_KEY=""          # alternative provider
# STUDY_AI_PROVIDER="nvidia"    # nvidia | anthropic
