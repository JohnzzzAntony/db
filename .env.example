# PostgreSQL connection string (Postgres 14+).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/koshys"

# Claude API key. Without it the app runs, but study generation, paper extraction and discovery are disabled.
ANTHROPIC_API_KEY=""
# NVIDIA model for study material (OpenAI-compatible API). Paper reading and web discovery still need ANTHROPIC_API_KEY.
NVIDIA_API_KEY=""
# NVIDIA_MODEL="nvidia/nemotron-3.5-bolt-e4b"
# STUDY_AI_PROVIDER="nvidia"   # nvidia | anthropic; defaults to nvidia when NVIDIA_API_KEY is set

# Optional overrides
# ANTHROPIC_MODEL="claude-opus-5-5"
# AI_EFFORT="high"          # low | medium | high | xhigh | max (study generation)
# AI_HOURLY_LIMIT=20        # generations per user per rolling hour
# MAX_UPLOAD_MB=15

# Used once by `npm run db:seed` to create the first administrator (password >= 12 chars).
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
