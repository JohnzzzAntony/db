generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Shared enums ───────────────────────────────────────────────────────────

/// How far a piece of academic data has been checked by a human.
enum VerificationStatus {
  VERIFIED
  UNVERIFIED
  REJECTED
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

// ─── Users & sessions ───────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(STUDENT)
  createdAt    DateTime @default(now())

  // The student's chosen academic context. Drives subject lists, PYQ filters and AI prompts.
  institutionId  String?
  institution    Institution?  @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  regulationId   String?
  regulation     Regulation?   @relation(fields: [regulationId], references: [id], onDelete: SetNull)
  academicYearId String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)

  sessions         Session[]
  studyDocuments   StudyDocument[]
  uploadedPapers   QuestionPaper[]  @relation("PaperUploader")
  verifiedPapers   QuestionPaper[]  @relation("PaperVerifier")
  uploadedSources  SourceDocument[]
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the cookie token; the raw token never touches the database.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Academic configuration ─────────────────────────────────────────────────

model University {
  id                 String             @id @default(cuid())
  name               String             @unique
  shortName          String?
  state              String?
  website            String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  regulations  Regulation[]
  institutions Institution[]
  papers       QuestionPaper[]
  clusters     QuestionCluster[]
  candidates   PaperCandidate[]
}

enum ExamStructure {
  YEARLY
  SEMESTER
}

/// A syllabus regulation of a university, e.g. "Post Basic B.Sc. Nursing (2-year), RGUHS".
model Regulation {
  id                  String             @id @default(cuid())
  universityId        String
  university          University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  course              String
  name                String
  syllabusYear        String?
  courseDurationYears Int                @default(2)
  examStructure       ExamStructure      @default(YEARLY)
  sourceUrl           String?
  verificationStatus  VerificationStatus @default(UNVERIFIED)
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  academicYears        AcademicYear[]
  institutions         Institution[]
  clinicalRequirements ClinicalRequirement[]
  papers               QuestionPaper[]
  users                User[]

  @@unique([universityId, name])
}

model Institution {
  id           String      @id @default(cuid())
  name         String      @unique
  city         String?
  state        String?
  country      String      @default("India")
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  regulationId String?
  regulation   Regulation? @relation(fields: [regulationId], references: [id], onDelete: SetNull)
  /// Free-text note on how the affiliation was (or was not) confirmed.
  affiliationNote String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users                User[]
  clinicalRequirements ClinicalRequirement[]
}

/// "Year" for yearly schemes, "Semester" for semester schemes.
model AcademicYear {
  id           String     @id @default(cuid())
  regulationId String
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  number       Int
  label        String

  subjects Subject[]
  users    User[]

  @@unique([regulationId, number])
}

enum SubjectCategory {
  NURSING_FOUNDATION_EDUCATION
  MEDICAL_SURGICAL
  CHILD_HEALTH
  MATERNAL_MIDWIFERY
  COMMUNITY_HEALTH
  MENTAL_HEALTH
  NURSING_ADMINISTRATION
  NURSING_RESEARCH_STATISTICS
  BASIC_SCIENCES
  BEHAVIOURAL_SCIENCES
  OTHER
}

model Subject {
  id                 String             @id @default(cuid())
  academicYearId     String
  academicYear       AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  code               String?
  name               String
  category           SubjectCategory    @default(OTHER)
  overview           String?
  theoryMarks        Int?
  theoryInternal     Int?
  practicalMarks     Int?
  practicalInternal  Int?
  theoryHours        Int?
  practicalHours     Int?
  examDurationHours  Float?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  units          Unit[]
  textbooks      Textbook[]
  sources        SourceDocument[]
  studyDocuments StudyDocument[]
  papers         QuestionPaper[]
  clusters       QuestionCluster[]

  @@unique([academicYearId, name])
}

model Unit {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  hours     Int?
  objectives String?

  topics    Topic[]
  questions Question[]

  @@unique([subjectId, number])
}

model Topic {
  id        String @id @default(cuid())
  unitId    String
  unit      Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int    @default(0)
}

/// Admin-entered recommended textbooks. These are the only books the AI may name as references
/// without a matching uploaded source.
model Textbook {
  id        String  @id @default(cuid())
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  authors   String
  edition   String?
  publisher String?
  year      Int?
  isbn      String?
}

enum RequirementGroup {
  CARE_PLAN
  CASE_STUDY
  CASE_PRESENTATION
  HEALTH_EDUCATION
  DRUG_PRESENTATION
  PROCEDURE
  ASSESSMENT
  ASSIGNMENT
  CLINICAL_FILE
  OTHER
}

model ClinicalRequirement {
  id              String           @id @default(cuid())
  institutionId   String?
  institution     Institution?     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  regulationId    String?
  regulation      Regulation?      @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  subjectCategory SubjectCategory
  group           RequirementGroup
  title           String
  quantity        Int              @default(1)
  quantityUnit    String?
  notes           String?
  /// Where this requirement came from, e.g. "Koshys College of Nursing requirement sheet".
  source          String?
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// ─── Knowledge library (RAG sources) ────────────────────────────────────────

enum SourceKind {
  TEXTBOOK_EXCERPT
  CLINICAL_GUIDELINE
  GOVERNMENT_PROGRAMME
  JOURNAL_ARTICLE
  LECTURE_NOTES
  SYLLABUS
  OTHER
}

/// A reference document uploaded by faculty/admin. Its chunks are what the AI may cite.
model SourceDocument {
  id                 String             @id @default(cuid())
  title              String
  kind               SourceKind
  authors            String?
  publisher          String?
  edition            String?
  year               Int?
  url                String?
  subjectId          String?
  subject            Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  uploadedById       String?
  uploadedBy         User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())

  chunks SourceChunk[]
}

/// Full-text search uses a GIN expression index on to_tsvector('english', content),
/// created in the migration SQL (Prisma cannot express it).
model SourceChunk {
  id         String         @id @default(cuid())
  documentId String
  document   SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal    Int
  page       Int?
  content    String

  @@unique([documentId, ordinal])
}

// ─── AI study material ──────────────────────────────────────────────────────

enum StudyMode {
  UNIVERSITY_EXAM
  QUICK_REVISION
  DETAILED_RESEARCH
  VIVA
}

model StudyDocument {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String
  subjectId String?
  subject   Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  mode      StudyMode
  marks     Int
  /// Validated StudyContent JSON (see src/lib/study/schema.ts).
  content   Json
  /// Source chunk ids that were offered to the model, for audit.
  sourceChunkIds String[]
  model     String
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ─── Previous-year question papers ──────────────────────────────────────────

enum ExamType {
  REGULAR
  SUPPLEMENTARY
  UNKNOWN
}

enum PaperOrigin {
  UPLOAD
  URL_IMPORT
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model QuestionPaper {
  id                 String             @id @default(cuid())
  universityId       String
  university         University         @relation(fields: [universityId], references: [id], onDelete: Restrict)
  regulationId       String?
  regulation         Regulation?        @relation(fields: [regulationId], references: [id], onDelete: SetNull)
  subjectId          String?
  subject            Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  course             String
  /// Subject name as printed on the paper.
  subjectNameRaw     String?
  subjectCode        String?
  yearOfStudy        String?
  examMonth          Int?
  examYear           Int?
  examType           ExamType           @default(UNKNOWN)
  totalMarks         Int?
  durationHours      Float?
  origin             PaperOrigin
  sourceUrl          String?
  fileName           String
  mimeType           String
  fileSize           Int
  fileData           Bytes
  /// SHA-256 of the file; prevents duplicate uploads of the same paper.
  fileHash           String             @unique
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationNote   String?
  verifiedById       String?
  verifiedBy         User?              @relation("PaperVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?
  uploadedById       String?
  uploadedBy         User?              @relation("PaperUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  extractionStatus   ExtractionStatus   @default(PENDING)
  extractionError    String?
  /// Metadata the AI read from the paper itself, kept separate from human-entered fields.
  detectedMetadata   Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  questions Question[]

  @@index([universityId, subjectId, examYear])
}

enum QuestionType {
  LONG_ESSAY
  SHORT_ESSAY
  SHORT_ANSWER
  VERY_SHORT_ANSWER
  MCQ
  FILL_IN_BLANK
  CASE_BASED
  OTHER
}

model Question {
  id             String           @id @default(cuid())
  paperId        String
  paper          QuestionPaper    @relation(fields: [paperId], references: [id], onDelete: Cascade)
  number         String
  text           String
  normalizedText String
  marks          Float?
  type           QuestionType     @default(OTHER)
  topic          String?
  unitId         String?
  unit           Unit?            @relation(fields: [unitId], references: [id], onDelete: SetNull)
  clusterId      String?
  cluster        QuestionCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  sortOrder      Int              @default(0)

  @@index([clusterId])
}

/// Questions across papers that ask the same thing (possibly with changed wording).
model QuestionCluster {
  id            String      @id @default(cuid())
  universityId  String
  university    University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  subjectId     String?
  subject       Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  /// Subject name fallback when papers are not linked to a configured subject.
  subjectKey    String
  canonicalText String
  topic         String?
  createdAt     DateTime    @default(now())

  questions Question[]

  @@index([universityId, subjectKey])
}

/// Links found by the AI web-search discovery tool. Never counted as papers until imported.
model PaperCandidate {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  query        String
  title        String
  url          String
  examYear     Int?
  note         String?
  imported     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([universityId, url])
}
